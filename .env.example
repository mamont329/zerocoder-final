# Скопируйте в .env и заполните своими значениями
# Секретный ключ Django: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Telegram-бот: токен от @BotFather
TELEGRAM_BOT_TOKEN=
# Имя бота без @ — используется для ссылки в профиле
TELEGRAM_BOT_USERNAME=

# Боевой запуск: DEBUG=False включает защищённые куки, HSTS и редирект на HTTPS.
# Здесь перечисляются адреса сайта через запятую, например https://fincontrol.example.com
CSRF_TRUSTED_ORIGINS=

# Почта. Пока EMAIL_HOST пуст, письма печатаются в консоль сервера
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_USE_TLS=True
