# Скопируйте в .env и заполните своими значениями
# Секретный ключ Django: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Telegram-бот: токен от @BotFather
TELEGRAM_BOT_TOKEN=
# Имя бота без @ — используется для ссылки в профиле
TELEGRAM_BOT_USERNAME=
